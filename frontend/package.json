{
  "name": "kronn-frontend",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "typecheck:native": "tsc -b --pretty false",
    "typecheck:legacy": "tsc6 -b --pretty false",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fast": "oxlint src --max-warnings 0",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/ensure-browser.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:perf": "playwright test --config=playwright.perf.config.ts",
    "test:perf:seed": "python3 e2e/perf/seed.py"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-virtual": "^3.14.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "node-emoji": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "happy-dom": "^20.11.2",
    "oxlint": "1.78.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
