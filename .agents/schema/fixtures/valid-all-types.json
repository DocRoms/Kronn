{
  "version": "1.0",
  "engine": "kronn",
  "requires": ["curl"],
  "inputs": {
    "my_string": { "type": "string", "default": "hello" },
    "my_number": { "type": "number", "default": 42 },
    "my_boolean": { "type": "boolean", "default": true },
    "my_list": { "type": "list", "default": ["a", "b"] }
  },
  "env": {
    "MY_SECRET": "${env:HOST_SECRET}"
  },
  "steps": [
    {
      "name": "step1",
      "run": "echo hello"
    }
  ]
}
